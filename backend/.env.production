NODE_ENV=production
PORT=3003
MULTIPLAYER_PORT=8080

# Database & Storage
# Use IndexedDB for client-side, but if server needs DB, specify here
DB_HOST=localhost
DB_USER=civic_operator_0
DB_PASS=change_me_securely

# Blockchain Config
# Use Infura, Alchemy, or your own node
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
KASPA_RPC_URL=https://rpc-testnet.kaspa.org

# CivicWatch API
CIVICWATCH_API_KEY=your_api_key_here

# Security
JWT_SECRET=super_secret_jwt_key_change_me
CORS_ORIGIN=https://civicverse.org

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
