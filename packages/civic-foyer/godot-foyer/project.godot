; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="NEON REIGN - The Foyer"
run/main_scene="res://scenes/main_launcher.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://assets/branding/icon.svg"

[autoload]

CivicAvatarManager="*res://scripts/autoloads/CivicAvatarManager.gd"
ShardPortalManager="*res://scripts/autoloads/ShardPortalManager.gd"
CivicFeedManager="*res://scripts/autoloads/CivicFeedManager.gd"
WalletManager="*res://scripts/autoloads/WalletManager.gd"
VehicleManager="*res://scripts/autoloads/VehicleManager.gd"
LiveStreamManager="*res://scripts/autoloads/LiveStreamManager.gd"
ReputationSystem="*res://scripts/autoloads/ReputationSystem.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

